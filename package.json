{
  "name": "expo-restore-credentials",
  "version": "0.1.1",
  "description": "Android Restore Credentials (zero-tap sign-in restoration) for Expo apps",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-restore-credentials",
    "android",
    "credential-manager",
    "restore-credentials",
    "passkeys",
    "zero-tap",
    "config-plugin"
  ],
  "repository": "https://github.com/pauldmps/expo-restore-credentials",
  "bugs": {
    "url": "https://github.com/pauldmps/expo-restore-credentials/issues"
  },
  "author": "Shantanu Paul <shantanupaul@live.com> (https://github.com/pauldmps)",
  "license": "MIT",
  "homepage": "https://github.com/pauldmps/expo-restore-credentials#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "build",
    "plugin/build",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src/main",
    "app.plugin.js",
    "expo-module.config.json",
    "src"
  ]
}
